/- The lemmas on `InAdd` are adapted from quotient-submodule-equidistribution
(QuotientSubmoduleEquidistribution.RepresentationTheory.AdditiveSubcategory, commit 20ee4b9,
Apache 2.0). -/
module

public import PretorsionImageClosed.IndecomposableClosures.SplitInjective
public import PretorsionImageClosed.Subcategories.Biproducts
public import PretorsionImageClosed.Statement

/-!
# Subcategories determined by indecomposable representatives

For an indecomposable skeleton `σ` of `FGModuleCat R`, a subcategory (in the
sense of `Statement.Subcategory`) is determined by the set of indecomposable
representatives it contains. The subcategory generated by a set `S` of
representatives is `add S` (`addOf`, the objects admitting a presentation as a
finite direct sum of representatives in `S`), and `C ↦ ind C` (`indOf`) and
`S ↦ add S` are inverse bijections (`indOf_addOf`, `addOf_indOf`).

Under this correspondence the quotient and submodule closures of `σ` are
`ind Gen(add S)` and `ind Cogen(add S)` (`mem_qSet_iff`, `mem_sSet_iff`), the
operators (4.2) of the manuscript.

Retract closure of `add S` (`inAdd_of_retract`) is the Krull–Schmidt input: an
indecomposable retract of a direct sum of representatives is one of them.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

open CategoryTheory CategoryTheory.Limits

namespace PretorsionImageClosed.IndecomposableSkeleton

universe u v w

variable {R : Type u} [Ring R] [IsNoetherianRing R] {ι : Type v}
  (σ : IndecomposableSkeleton.{u, v, w} R ι)

attribute [local instance] HasFiniteBiproducts.of_hasFiniteCoproducts

/-! ### Additive closures of representatives -/

theorem inAdd_mono {S T : Set ι} (hST : S ⊆ T) {X : FGModuleCat.{w} R} :
    σ.InAdd S X → σ.InAdd T X := by
  rintro ⟨P⟩
  exact ⟨{
    index := P.index, label := P.label, mem := (fun t => hST (P.mem t)), iso := P.iso }⟩

theorem inAdd_of_iso {S : Set ι} {X Y : FGModuleCat.{w} R} (e : X ≅ Y) (hX : σ.InAdd S X) :
    σ.InAdd S Y := by
  obtain ⟨P⟩ := hX
  exact ⟨{
    index := P.index, label := P.label, mem := P.mem, iso := e.symm ≪≫ P.iso }⟩

/-- A finite biproduct of objects of `add S` lies in `add S`. -/
theorem inAdd_biproduct {S : Set ι} (J : FintypeCat.{0}) (F : J → FGModuleCat.{w} R)
    (hF : ∀ j, σ.InAdd S (F j)) : σ.InAdd S (biproduct F) := by
  classical
  let inner : ∀ j : J, σ.AddPresentation S (F j) := fun j ↦ Classical.choice (hF j)
  let K : FintypeCat.{0} := FintypeCat.of (Σ j : J, (inner j).index)
  let a : K → ι := fun p ↦ (inner p.1).label p.2
  let componentIso : (⨁ F) ≅ (⨁ fun j : J ↦ σ.sumOver (inner j).index (inner j).label) :=
    biproduct.mapIso fun j ↦ (inner j).iso
  let flattenIso : (⨁ fun j : J ↦ σ.sumOver (inner j).index (inner j).label) ≅ σ.sumOver K a :=
    biproductBiproductIso (fun j : J ↦ (inner j).index) (fun j t ↦ σ.obj ((inner j).label t))
  exact ⟨{
    index := K
    label := a
    mem := fun p ↦ (inner p.1).mem p.2
    iso := componentIso ≪≫ flattenIso }⟩

/-- Every representative in `S` lies in `add S`. -/
theorem inAdd_obj {S : Set ι} {i : ι} (hi : i ∈ S) : σ.InAdd S (σ.obj i) := by
  let a : Fin 1 → ι := fun _ ↦ i
  exact ⟨{
    index := FintypeCat.of (Fin 1)
    label := a
    mem := fun _ ↦ hi
    iso := (biproductUniqueIso fun t : Fin 1 ↦ σ.obj (a t)).symm }⟩

/-- An indecomposable representative which is a retract of an object of `add S` lies in `S`. -/
theorem index_mem_of_retract_inAdd {S : Set ι} {i : ι} {Y : FGModuleCat.{w} R}
    (r : Retract (σ.obj i) Y) (hY : σ.InAdd S Y) : i ∈ S := by
  classical
  obtain ⟨P⟩ := hY
  let g : σ.obj i ⟶ σ.sumOver P.index P.label := r.i ≫ P.iso.hom
  let s : SplitMono g := { retraction := P.iso.inv ≫ r.r, id := by simp [g] }
  letI : IsSplitMono g := ⟨⟨s⟩⟩
  let Q : σ.SubPresentation S (σ.obj i) :=
    { index := P.index, label := P.label, mem := P.mem, map := g, mono := inferInstance }
  by_contra hi
  have hne : ∀ t, i ≠ Q.label t := by
    intro t hit
    apply hi
    simpa only [Q] using hit ▸ P.mem t
  exact (not_splitMono_of_labels_ne σ Q hne) ⟨s⟩

/-- `add S` is closed under retracts. -/
theorem inAdd_of_retract {S : Set ι} {X Y : FGModuleCat.{w} R} (r : Retract X Y)
    (hY : σ.InAdd S Y) : σ.InAdd S X := by
  classical
  obtain ⟨n, a, ⟨e⟩⟩ := σ.decomposes X
  have ha : ∀ t : Fin n, a t ∈ S := by
    intro t
    let rt : Retract (σ.obj (a t)) X :=
      { i := biproduct.ι (fun j : Fin n ↦ σ.obj (a j)) t ≫ e.inv
        r := e.hom ≫ biproduct.π (fun j : Fin n ↦ σ.obj (a j)) t
        retract := by simp }
    exact index_mem_of_retract_inAdd σ (rt.trans r) hY
  exact ⟨{
    index := FintypeCat.of (Fin n), label := a, mem := ha, iso := e }⟩

/-! ### The subcategory `add S` -/

/-- The subcategory `add S` generated by a set of representatives. -/
def addOf (S : Set ι) : Statement.Subcategory (FGModuleCat.{w} R) where
  prop := σ.InAdd S
  prop_of_retract h hY := inAdd_of_retract σ h hY
  prop_biprod {X Y} hX hY := by
    let f : Fin 2 → FGModuleCat.{w} R := ![X, Y]
    have hf : σ.InAdd S (⨁ f) := inAdd_biproduct σ (FintypeCat.of (Fin 2)) f (by
      intro j
      refine Fin.cases ?_ (fun j => ?_) j
      · exact hX
      · have : j = 0 := Subsingleton.elim _ _
        subst this
        exact hY)
    refine inAdd_of_iso σ ((biproductFinSuccIso f).trans ?_) hf
    exact biprod.mapIso (Iso.refl _) (biproductUniqueIso _)
  prop_of_isZero {X} h := by
    let a : Fin 0 → ι := fun t => t.elim0
    refine ⟨{ index := FintypeCat.of (Fin 0), label := a, mem := (fun t => t.elim0), iso := ?_ }⟩
    refine h.iso ?_
    rw [IsZero.iff_id_eq_zero]
    apply biproduct.hom_ext'
    intro t
    exact t.elim0

theorem addOf_prop {S : Set ι} {X : FGModuleCat.{w} R} : (σ.addOf S).prop X ↔ σ.InAdd S X :=
  Iff.rfl

/-- The set of representatives lying in a subcategory: `ind C`. -/
def indOf (Z : Statement.Subcategory (FGModuleCat.{w} R)) : Set ι := {i | Z.prop (σ.obj i)}

theorem mem_indOf {Z : Statement.Subcategory (FGModuleCat.{w} R)} {i : ι} :
    i ∈ σ.indOf Z ↔ Z.prop (σ.obj i) := Iff.rfl

theorem indOf_addOf (S : Set ι) : σ.indOf (σ.addOf S) = S := by
  ext i
  exact ⟨fun h => index_mem_of_retract_inAdd σ (Retract.refl _) h, fun h => inAdd_obj σ h⟩

/-- Every subcategory is generated by its indecomposable representatives. -/
theorem prop_iff_inAdd_indOf (Z : Statement.Subcategory (FGModuleCat.{w} R))
    (X : FGModuleCat.{w} R) : Z.prop X ↔ σ.InAdd (σ.indOf Z) X := by
  classical
  constructor
  · intro hX
    obtain ⟨n, a, ⟨e⟩⟩ := σ.decomposes X
    refine ⟨{ index := FintypeCat.of (Fin n), label := a, mem := (fun t => ?_), iso := e }⟩
    let rt : Retract (σ.obj (a t)) X :=
      { i := biproduct.ι (fun j : Fin n ↦ σ.obj (a j)) t ≫ e.inv
        r := e.hom ≫ biproduct.π (fun j : Fin n ↦ σ.obj (a j)) t
        retract := by simp }
    exact Z.prop_of_retract rt hX
  · rintro ⟨P⟩
    letI : Fintype P.index := FintypeCat.fintype
    exact Z.prop_of_iso P.iso.symm (Z.prop_biproduct _ fun t => P.mem t)

theorem addOf_indOf (Z : Statement.Subcategory (FGModuleCat.{w} R)) :
    σ.addOf (σ.indOf Z) = Z := by
  apply Statement.Subcategory.ext
  funext X
  exact propext (σ.prop_iff_inAdd_indOf Z X).symm

/-! ### Quotient and submodule closures as `ind Gen (add S)` and `ind Cogen (add S)` -/

theorem inFac_iff (S : Set ι) (X : FGModuleCat.{w} R) :
    σ.InFac S X ↔ Statement.Gen (σ.addOf S) X := by
  constructor
  · rintro ⟨P⟩
    letI : Fintype P.index := FintypeCat.fintype
    refine ⟨σ.sumOver P.index P.label, ?_, P.map, P.epi⟩
    exact (σ.addOf S).prop_biproduct _ fun t => inAdd_obj σ (P.mem t)
  · rintro ⟨Y, hY, p, hp⟩
    obtain ⟨P⟩ := hY
    exact ⟨{
      index := P.index
      label := P.label
      mem := P.mem
      map := P.iso.inv ≫ p
      epi := epi_comp _ _ }⟩

theorem inSub_iff (S : Set ι) (X : FGModuleCat.{w} R) :
    σ.InSub S X ↔ Statement.Cogen (σ.addOf S) X := by
  constructor
  · rintro ⟨P⟩
    letI : Fintype P.index := FintypeCat.fintype
    refine ⟨σ.sumOver P.index P.label, ?_, P.map, P.mono⟩
    exact (σ.addOf S).prop_biproduct _ fun t => inAdd_obj σ (P.mem t)
  · rintro ⟨Y, hY, i, hi⟩
    obtain ⟨P⟩ := hY
    exact ⟨{
      index := P.index
      label := P.label
      mem := P.mem
      map := i ≫ P.iso.hom
      mono := mono_comp _ _ }⟩

/-- (4.2): the quotient closure is `qcl(S) = ind Gen(add S)`. -/
theorem mem_qSet_iff (S : Set ι) (i : ι) :
    i ∈ σ.qSet S ↔ Statement.Gen (σ.addOf S) (σ.obj i) :=
  σ.inFac_iff S (σ.obj i)

/-- (4.2): the submodule closure is `scl(S) = ind Cogen(add S)`. -/
theorem mem_sSet_iff (S : Set ι) (i : ι) :
    i ∈ σ.sSet S ↔ Statement.Cogen (σ.addOf S) (σ.obj i) :=
  σ.inSub_iff S (σ.obj i)

end PretorsionImageClosed.IndecomposableSkeleton
